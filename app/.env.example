# Mode MOCK: bila GAS_URL/GAS_TOKEN dikosongkan, app memakai data contoh
# in-memory (src/lib/seed.ts) + secret dev — cukup untuk menjelajah UI.
# Produksi wajib isi ketiganya.
# GAS_URL=
# GAS_TOKEN=

# Google Apps Script (spreadsheet sebagai database)
GAS_URL=https://script.google.com/macros/s/XXXX/exec
GAS_TOKEN=isi-token-rahasia-bersama

# Sesi login (min. 32 karakter acak)
SESSION_SECRET=isi-rahasia-acak-min-32-karakter

# Database deploy Docker (docker-compose.yml): Postgres ikut di compose.
# WAJIB diisi di .env server — tanpa ini `docker compose up` menolak start.
# DATABASE_URL dikosongkan = rakit otomatis ke service db (cukup untuk umum).
# Password berkarakter khusus (@ : / ? #) wajib URL-encode di DATABASE_URL.
POSTGRES_USER=tmb
POSTGRES_PASSWORD=isi-password-kuat-di-sini
POSTGRES_DB=tmb
# DATABASE_URL=postgres://tmb:isi-password-kuat-di-sini@db:5432/tmb

# Produksi standalone (`bun run start`): port + host.
# HOST=0.0.0.0 bila diakses via IP publik; 127.0.0.1 di balik reverse proxy.
PORT=2626
HOST=127.0.0.1

# Cookie Secure dimatikan hanya saat produksi HTTP polos (IP:port tanpa HTTPS).
# Default aman (true) — biarkan kosong/di-true saat sudah HTTPS.
COOKIE_SECURE=false
